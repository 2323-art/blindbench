{
  "name": "blindbench-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vercel": "node --check api/index.mjs && node --check lib/cloud-app.mjs && node --check public/app.js",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "wallet": "node scripts/wallet.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.14",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "@x402/cardano": "2.28.0",
    "@x402/core": "2.28.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
